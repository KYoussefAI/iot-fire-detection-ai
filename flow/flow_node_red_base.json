    {
        "id": "551d5cf66cbb8629",
        "type": "function",
        "z": "5bb61ebb48387936",
        "name": "Fire Risk Pre-Alert Logic",
        "func": "let p = msg.payload;\n\nif (\n    p.temperature > 65 ||\n    p.smoke > 650 ||\n    p.gas > 600\n) {\n    p.pre_alert = \"danger\";\n}\nelse if (\n    p.temperature > 45 ||\n    p.smoke > 250 ||\n    p.gas > 300\n) {\n    p.pre_alert = \"suspect\";\n}\nelse {\n    p.pre_alert = \"normal\";\n}\n\nmsg.payload = p;\n\nreturn msg;",
