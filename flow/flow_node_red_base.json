    {
        "id": "ef5bfe5528a1fbc6",
        "type": "function",
        "z": "5bb61ebb48387936",
        "name": "Normalize Sensor Values",
        "func": "let p = msg.payload;\n\np.temperature = Number(p.temperature);\np.smoke = Number(p.smoke);\np.gas = Number(p.gas);\np.humidity = Number(p.humidity);\n\nmsg.payload = p;\n\nreturn msg;",
