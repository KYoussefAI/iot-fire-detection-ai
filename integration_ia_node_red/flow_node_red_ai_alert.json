    {
        "id": "2e3c72aa901e77cd",
        "type": "function",
        "z": "3f9af7491622b8c9",
        "name": "Validate Sensor Payload",
        "func": "let p = msg.payload;\n\nconst requiredFields = [\n    \"device_id\",\n    \"timestamp\",\n    \"temperature\",\n    \"smoke\",\n    \"gas\",\n    \"humidity\",\n    \"location\"\n];\n\nfor (let field of requiredFields) {\n    if (p[field] === undefined || p[field] === null) {\n        node.warn(\"Missing field: \" + field);\n        return null;\n    }\n}\n\nif (\n    isNaN(Number(p.temperature)) ||\n    isNaN(Number(p.smoke)) ||\n    isNaN(Number(p.gas)) ||\n    isNaN(Number(p.humidity))\n) {\n    node.warn(\"Invalid numeric values\");\n    return null;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 550,
        "y": 540,
        "wires": [
            [
                "7f41a188c45d1b7b"
            ]
        ]
    },
    {
        "id": "7f41a188c45d1b7b",
        "type": "function",
        "z": "3f9af7491622b8c9",
        "name": "Normalize Sensor Values",
        "func": "let p = msg.payload;\n\np.temperature = Number(p.temperature);\np.smoke = Number(p.smoke);\np.gas = Number(p.gas);\np.humidity = Number(p.humidity);\n\nmsg.payload = p;\n\nreturn msg;",
        "outputs": 1,
