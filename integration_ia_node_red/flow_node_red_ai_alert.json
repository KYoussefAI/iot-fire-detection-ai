    {
        "id": "b978f11506a54a89",
        "type": "function",
        "z": "3f9af7491622b8c9",
        "name": "Merge IA Result",
        "func": "let sensor = msg.sensor;\nlet ai = msg.payload;\n\n// Vérification : est-ce qu'on a encore le message capteur original ?\nif (!sensor) {\n    node.error(\"Message capteur original introuvable dans msg.sensor\", msg);\n    return null;\n}\n\n// Si la réponse IA est encore sous forme texte, on la convertit en JSON\nif (typeof ai === \"string\") {\n    try {\n        ai = JSON.parse(ai);\n    } catch (e) {\n        node.error(\"Sortie IA non JSON : \" + ai, msg);\n        return null;\n    }\n}\n\n// Si predict.py retourne une erreur\nif (ai.error) {\n    node.error(\"Erreur IA : \" + ai.error, msg);\n    return null;\n}\n\n// Enrichir le message capteur avec le résultat IA\nsensor.ai_status = ai.ai_status;\nsensor.risk_score = Number(ai.risk_score || 0);\n\n// Règle d'alerte\nsensor.alert = sensor.ai_status === \"danger\";\n\n// Remettre le message complet dans msg.payload\nmsg.payload = sensor;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
