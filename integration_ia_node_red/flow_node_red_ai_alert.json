    {
        "id": "beec55db842a12b9",
        "type": "function",
        "z": "3f9af7491622b8c9",
        "name": "Prepare IA Command",
        "func": "let p = msg.payload;\n\n// Garder une copie du message capteur original.\n// Le node exec va remplacer msg.payload par la sortie de predict.py,\n// donc on sauvegarde les données initiales dans msg.sensor.\nmsg.sensor = JSON.parse(JSON.stringify(p));\n\n// Préparer les 4 arguments pour predict.py :\n// temperature smoke gas humidity\nmsg.payload = `${p.temperature} ${p.smoke} ${p.gas} ${p.humidity}`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
